# Django Settings
# Generate a new random secret key for production
SECRET_KEY=your-production-secret-key-goes-here
# Must be False in production
DEBUG=False
# List your production domains (e.g. mes.example.com,12.34.56.78)
ALLOWED_HOSTS=mes.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://mes.yourdomain.com

# Database Settings
DB_NAME=napino_mes
DB_USER=postgres
# Use a strong, random password in production
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# HTTPS and trusted reverse-proxy settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False

# Authentication throttling
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# Import safety limits
MAX_IMPORT_FILE_SIZE=10485760
MAX_IMPORT_UNCOMPRESSED_SIZE=104857600
MAX_IMPORT_ROWS=50000
MAX_IMPORT_COLUMNS=100

# One-time initial administrator creation; remove these after use
MES_SEED_USERNAME=
MES_SEED_PASSWORD=
