# Public DNS name. Point its A/AAAA record at this server before starting Caddy.
MES_DOMAIN=mes.example.com

# Django security. Generate with: openssl rand -base64 48
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=mes.example.com
CSRF_TRUSTED_ORIGINS=https://mes.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# PostgreSQL (used by the Compose-managed database container)
DB_NAME=napino_mes
DB_USER=mes
DB_PASSWORD=replace-with-a-long-random-password
# Required by the PostgreSQL container. Keep these equal to DB_* above.
POSTGRES_DB=napino_mes
POSTGRES_USER=mes
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Set these to the values at the factory. Leave empty only where the integration
# is intentionally unavailable.
LASER_SERIAL_FILE=
SCANNER_PORT=
SCANNER_BAUDRATE=115200
SCANNER_TIMEOUT=1
PLC_HOST=
PLC_PORT=502
PLC_TIMEOUT=1

# Create the first administrator once, then remove both values.
MES_SEED_USERNAME=admin
MES_SEED_PASSWORD=change-this-immediately
